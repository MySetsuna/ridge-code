{
  "provider": "openai",
  "model": "glm-4.6",
  "base_url": "https://open.bigmodel.cn/api/paas/v4",
  "api_key": "把你的密钥明文填在这里即可直接启动(自担明文存盘风险);不想明文就删掉此行,改为设 RIDGE_API_KEY 环境变量",
  "budget_tokens": 200000,
  "skip_danger": false,
  "providers": [
    {
      "name": "zhipu",
      "kind": "openai",
      "model": "glm-4.6",
      "base_url": "https://open.bigmodel.cn/api/paas/v4",
      "key_env": "RIDGE_API_KEY"
    },
    {
      "name": "kimi",
      "kind": "openai",
      "model": "kimi-k2",
      "base_url": "https://api.moonshot.cn/v1",
      "key_env": "MOONSHOT_KEY"
    }
  ],
  "mcp": [
    {
      "name": "anysearch",
      "cmd": "cmd",
      "args": ["/c", "npx", "-y", "mcp-remote", "https://api.anysearch.com/mcp"]
    },
    {
      "name": "codegraph",
      "cmd": "codegraph",
      "args": ["serve", "--mcp"]
    }
  ]
}
